{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "description": "UVM Test Timing Configuration - Recommended timeouts and execution parameters",
  "version": "1.0.0",
  "last_updated": "2024-12-21",
  "default_timeout": 300,
  "default_verbosity": "UVM_LOW",
  "tests": {
    "axiuart_basic_test": {
      "timeout": 180,
      "operations": 10,
      "measured_time_ms": 100,
      "recommended_verbosity": "UVM_LOW",
      "description": "Basic register R/W validation",
      "category": "fast",
      "waves_recommended": false,
      "notes": "Quick smoke test"
    },
    "axiuart_reset_test": {
      "timeout": 180,
      "operations": 5,
      "measured_time_ms": 50,
      "recommended_verbosity": "UVM_LOW",
      "description": "Reset sequence verification",
      "category": "fast",
      "waves_recommended": false,
      "notes": "Reset behavior validation"
    },
    "axiuart_reg_rw_test": {
      "timeout": 180,
      "operations": 20,
      "measured_time_ms": 200,
      "recommended_verbosity": "UVM_LOW",
      "description": "Register access pattern test",
      "category": "fast",
      "waves_recommended": false,
      "notes": "Multiple register access patterns"
    },
    "axiuart_cpu_debug_test": {
      "timeout": 300,
      "operations": 50,
      "measured_time_ms": 5000,
      "recommended_verbosity": "UVM_MEDIUM",
      "description": "CPU debug register access",
      "category": "medium",
      "waves_recommended": true,
      "notes": "Debug interface verification"
    },
    "axiuart_cpu_simple_mem_test": {
      "timeout": 180,
      "operations": 7,
      "measured_time_ms": 46,
      "recommended_verbosity": "UVM_LOW",
      "description": "Simple CPU memory verification",
      "category": "fast",
      "waves_recommended": false,
      "notes": "Basic memory access validation (7/7 matches verified)",
      "status": "validated",
      "validation_date": "2024-12-21"
    },
    "axiuart_cpu_logic_test": {
      "timeout": 600,
      "timeout_debug": 1200,
      "operations": 18,
      "measured_time_ms": 90000,
      "recommended_verbosity": "UVM_MEDIUM",
      "debug_verbosity": "UVM_HIGH",
      "description": "Comprehensive CPU ALU and logic verification with trace buffer",
      "category": "medium",
      "waves_recommended": true,
      "test_phases": [
        {
          "phase": "arithmetic",
          "operations": 7,
          "tests": ["ADD", "SUB"]
        },
        {
          "phase": "logical",
          "operations": 4,
          "tests": ["AND", "OR", "XOR"]
        },
        {
          "phase": "comparison",
          "operations": 3,
          "tests": ["CMP"]
        },
        {
          "phase": "shift",
          "operations": 3,
          "tests": ["SHL1", "SHR1"]
        },
        {
          "phase": "move",
          "operations": 1,
          "tests": ["MOV"]
        }
      ],
      "notes": "Uses trace buffer for fast verification, reduced from UART polling overhead",
      "uart_timing": {
        "baud_rate": 115200,
        "transaction_time_us": 313,
        "polling_overhead_eliminated": true,
        "note": "Trace buffer provides 50-900x speedup vs UART polling"
      },
      "status": "in_validation",
      "validation_date": "2024-12-26"
    },
    "axiuart_cpu_memory_test": {
      "timeout": 1200,
      "timeout_debug": 2400,
      "operations": 640,
      "measured_time_ms": 1920000,
      "recommended_verbosity": "UVM_LOW",
      "debug_verbosity": "UVM_DEBUG",
      "description": "Comprehensive March C- memory algorithm test",
      "category": "slow",
      "waves_recommended": true,
      "test_phases": [
        {
          "phase": 0,
          "name": "Write 0",
          "direction": "any",
          "operations": 64
        },
        {
          "phase": 1,
          "name": "Read 0, Write 1",
          "direction": "up",
          "operations": 128
        },
        {
          "phase": 2,
          "name": "Read 1, Write 0",
          "direction": "up",
          "operations": 128
        },
        {
          "phase": 3,
          "name": "Read 0, Write 1",
          "direction": "down",
          "operations": 128
        },
        {
          "phase": 4,
          "name": "Read 1, Write 0",
          "direction": "down",
          "operations": 128
        },
        {
          "phase": 5,
          "name": "Read 0",
          "direction": "any",
          "operations": 64
        }
      ],
      "notes": "March C- algorithm for comprehensive memory testing (319/319 matches verified)",
      "uart_timing": {
        "baud_rate": 115200,
        "transaction_time_us": 313,
        "note": "Time includes UART frame overhead"
      },
      "status": "validated",
      "validation_date": "2024-12-21"
    }
  },
  "categories": {
    "fast": {
      "description": "Quick tests (<5s)",
      "ci_recommended": true,
      "typical_timeout": 180
    },
    "medium": {
      "description": "Medium tests (5-60s)",
      "ci_recommended": true,
      "typical_timeout": 300
    },
    "slow": {
      "description": "Slow tests (>1min)",
      "ci_recommended": false,
      "typical_timeout": 1200
    }
  },
  "verbosity_levels": {
    "UVM_NONE": {
      "description": "No UVM messages",
      "log_size": "minimal",
      "performance_impact": "0%"
    },
    "UVM_LOW": {
      "description": "Essential messages only",
      "log_size": "small",
      "performance_impact": "<5%"
    },
    "UVM_MEDIUM": {
      "description": "Moderate detail",
      "log_size": "medium",
      "performance_impact": "~10%"
    },
    "UVM_HIGH": {
      "description": "Detailed messages",
      "log_size": "large",
      "performance_impact": "~20%"
    },
    "UVM_DEBUG": {
      "description": "Full phase tracing",
      "log_size": "very_large",
      "performance_impact": "~30%"
    }
  },
  "usage_notes": [
    "Timeouts are in seconds",
    "Measured times are in milliseconds",
    "Times based on 115200 baud UART communication",
    "Debug timeouts (timeout_debug) should be used with UVM_DEBUG verbosity",
    "Wave dumping adds ~5-10% overhead"
  ]
}
