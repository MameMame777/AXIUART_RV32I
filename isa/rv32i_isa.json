      "format": "S",
      "opcode": "0b0100011",
      "funct3": "0b001",
      "operation": "M[rs1 + imm][15:0] = rs2[15:0]",
      "description": "Store lowest 16 bits of rs2 to memory.",
      "pseudocode": "mem[x[rs1] + sext(imm)][15:0] = x[rs2][15:0]",
