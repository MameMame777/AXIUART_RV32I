{
  "isa_name": "RISC-V RV32I Base Integer Instruction Set",
  "version": "2.1",
  "description": "Clean-slate RISC-V RV32I implementation with 5-stage pipeline (IF/ID/EX/MEM/WB), 32x32-bit registers (x0 hardwired to zero), byte-addressed memory, stall+flush on branches (no speculation).",
  "data_width": 32,
  "address_width": 32,
  "instruction_width": 32,
  "register_count": 32,
  "memory_addressing": "byte",
  "pipeline_stages": ["IF", "ID", "EX", "MEM", "WB"],
  
  "instruction_formats": {
    "R": {
      "description": "Register-register ALU operations",
      "width": 32,
      "fields": {
        "opcode": {"bits": "6:0", "width": 7},
        "rd": {"bits": "11:7", "width": 5},
        "funct3": {"bits": "14:12", "width": 3},
        "rs1": {"bits": "19:15", "width": 5},
        "rs2": {"bits": "24:20", "width": 5},
        "funct7": {"bits": "31:25", "width": 7}
      }
    },
    "I": {
      "description": "Immediate ALU operations and loads",
      "width": 32,
      "fields": {
        "opcode": {"bits": "6:0", "width": 7},
        "rd": {"bits": "11:7", "width": 5},
        "funct3": {"bits": "14:12", "width": 3},
        "rs1": {"bits": "19:15", "width": 5},
        "imm": {"bits": "31:20", "width": 12, "signed": true}
      }
    },
    "S": {
      "description": "Store instructions",
      "width": 32,
      "fields": {
        "opcode": {"bits": "6:0", "width": 7},
        "imm_4_0": {"bits": "11:7", "width": 5},
        "funct3": {"bits": "14:12", "width": 3},
        "rs1": {"bits": "19:15", "width": 5},
        "rs2": {"bits": "24:20", "width": 5},
        "imm_11_5": {"bits": "31:25", "width": 7}
      },
      "immediate": {
        "assembly": "{imm_11_5, imm_4_0}",
        "width": 12,
        "signed": true
      }
    },
    "B": {
      "description": "Branch instructions",
      "width": 32,
      "fields": {
        "opcode": {"bits": "6:0", "width": 7},
        "imm_11": {"bits": "7", "width": 1},
        "imm_4_1": {"bits": "11:8", "width": 4},
        "funct3": {"bits": "14:12", "width": 3},
        "rs1": {"bits": "19:15", "width": 5},
        "rs2": {"bits": "24:20", "width": 5},
        "imm_10_5": {"bits": "30:25", "width": 6},
        "imm_12": {"bits": "31", "width": 1}
      },
      "immediate": {
        "assembly": "{imm_12, imm_11, imm_10_5, imm_4_1, 1'b0}",
        "width": 13,
        "signed": true,
        "note": "LSB always 0 for halfword alignment"
      }
    },
    "U": {
      "description": "Upper immediate (LUI, AUIPC)",
      "width": 32,
      "fields": {
        "opcode": {"bits": "6:0", "width": 7},
        "rd": {"bits": "11:7", "width": 5},
        "imm": {"bits": "31:12", "width": 20}
      },
      "immediate": {
        "assembly": "{imm, 12'b0}",
        "width": 32,
        "signed": true
      }
    },
    "J": {
      "description": "Jump instructions (JAL)",
      "width": 32,
      "fields": {
        "opcode": {"bits": "6:0", "width": 7},
        "rd": {"bits": "11:7", "width": 5},
        "imm_19_12": {"bits": "19:12", "width": 8},
        "imm_11": {"bits": "20", "width": 1},
        "imm_10_1": {"bits": "30:21", "width": 10},
        "imm_20": {"bits": "31", "width": 1}
      },
      "immediate": {
        "assembly": "{imm_20, imm_19_12, imm_11, imm_10_1, 1'b0}",
        "width": 21,
        "signed": true,
        "note": "LSB always 0 for halfword alignment"
      }
    }
  },
  
  "opcodes": {
    "LOAD": "0b0000011",
    "LOAD_FP": "0b0000111",
    "MISC_MEM": "0b0001111",
    "OP_IMM": "0b0010011",
    "AUIPC": "0b0010111",
    "STORE": "0b0100011",
    "STORE_FP": "0b0100111",
    "OP": "0b0110011",
    "LUI": "0b0110111",
    "BRANCH": "0b1100011",
    "JALR": "0b1100111",
    "JAL": "0b1101111",
    "SYSTEM": "0b1110011"
  },
  
  "instructions": [
    {
      "mnemonic": "LUI",
      "name": "Load Upper Immediate",
      "format": "U",
      "opcode": "0b0110111",
      "operation": "rd = imm_31_12 << 12",
      "description": "Build 32-bit constants. Places U-immediate value in top 20 bits of rd, filling lowest 12 bits with zeros.",
      "pseudocode": "x[rd] = sext(imm[31:12] << 12)"
    },
    {
      "mnemonic": "AUIPC",
      "name": "Add Upper Immediate to PC",
      "format": "U",
      "opcode": "0b0010111",
      "operation": "rd = PC + (imm_31_12 << 12)",
      "description": "Build PC-relative addresses. Forms 32-bit offset from 20-bit U-immediate, adds to PC.",
      "pseudocode": "x[rd] = PC + sext(imm[31:12] << 12)"
    },
    {
      "mnemonic": "JAL",
      "name": "Jump and Link",
      "format": "J",
      "opcode": "0b1101111",
      "operation": "rd = PC + 4; PC = PC + imm_20_1",
      "description": "Jump to address and store return address (PC+4) in rd. PC-relative offset.",
      "pseudocode": "x[rd] = PC + 4; PC = PC + sext(imm)",
      "control_flow": true,
      "link_register": true
    },
    {
      "mnemonic": "JALR",
      "name": "Jump and Link Register",
      "format": "I",
      "opcode": "0b1100111",
      "funct3": "0b000",
      "operation": "rd = PC + 4; PC = (rs1 + imm) & ~1",
      "description": "Jump to address (rs1 + imm) with LSB cleared, store PC+4 in rd.",
      "pseudocode": "t = PC + 4; PC = (x[rs1] + sext(imm)) & ~1; x[rd] = t",
      "control_flow": true,
      "link_register": true
    },
    {
      "mnemonic": "BEQ",
      "name": "Branch if Equal",
      "format": "B",
      "opcode": "0b1100011",
      "funct3": "0b000",
      "operation": "if (rs1 == rs2) PC = PC + imm",
      "description": "Branch to PC+imm if rs1 equals rs2.",
      "pseudocode": "if (x[rs1] == x[rs2]) PC = PC + sext(imm)",
      "control_flow": true
    },
    {
      "mnemonic": "BNE",
      "name": "Branch if Not Equal",
      "format": "B",
      "opcode": "0b1100011",
      "funct3": "0b001",
      "operation": "if (rs1 != rs2) PC = PC + imm",
      "description": "Branch to PC+imm if rs1 not equal rs2.",
      "pseudocode": "if (x[rs1] != x[rs2]) PC = PC + sext(imm)",
      "control_flow": true
    },
    {
      "mnemonic": "BLT",
      "name": "Branch if Less Than",
      "format": "B",
      "opcode": "0b1100011",
      "funct3": "0b100",
      "operation": "if (rs1 <s rs2) PC = PC + imm",
      "description": "Branch to PC+imm if rs1 < rs2 (signed comparison).",
      "pseudocode": "if (x[rs1] <s x[rs2]) PC = PC + sext(imm)",
      "control_flow": true
    },
    {
      "mnemonic": "BGE",
      "name": "Branch if Greater or Equal",
      "format": "B",
      "opcode": "0b1100011",
      "funct3": "0b101",
      "operation": "if (rs1 >=s rs2) PC = PC + imm",
      "description": "Branch to PC+imm if rs1 >= rs2 (signed comparison).",
      "pseudocode": "if (x[rs1] >=s x[rs2]) PC = PC + sext(imm)",
      "control_flow": true
    },
    {
      "mnemonic": "BLTU",
      "name": "Branch if Less Than Unsigned",
      "format": "B",
      "opcode": "0b1100011",
      "funct3": "0b110",
      "operation": "if (rs1 <u rs2) PC = PC + imm",
      "description": "Branch to PC+imm if rs1 < rs2 (unsigned comparison).",
      "pseudocode": "if (x[rs1] <u x[rs2]) PC = PC + sext(imm)",
      "control_flow": true
    },
    {
      "mnemonic": "BGEU",
      "name": "Branch if Greater or Equal Unsigned",
      "format": "B",
      "opcode": "0b1100011",
      "funct3": "0b111",
      "operation": "if (rs1 >=u rs2) PC = PC + imm",
      "description": "Branch to PC+imm if rs1 >= rs2 (unsigned comparison).",
      "pseudocode": "if (x[rs1] >=u x[rs2]) PC = PC + sext(imm)",
      "control_flow": true
    },
    {
      "mnemonic": "LB",
      "name": "Load Byte",
      "format": "I",
      "opcode": "0b0000011",
      "funct3": "0b000",
      "operation": "rd = sext(M[rs1 + imm][7:0])",
