      "name": "Add Immediate",
      "format": "I",
      "opcode": "0b0010011",
      "funct3": "0b000",
      "operation": "rd = rs1 + imm",
      "description": "Add sign-extended 12-bit immediate to rs1. Overflow ignored.",
      "pseudocode": "x[rd] = x[rs1] + sext(imm)",
      "notes": "ADDI rd, rs1, 0 is MV pseudo-instruction"
