      "format": "I",
      "opcode": "0b0000011",
      "funct3": "0b100",
      "operation": "rd = zext(M[rs1 + imm][7:0])",
      "description": "Load 8-bit value from memory, zero-extend to 32 bits.",
      "pseudocode": "x[rd] = zext(mem[x[rs1] + sext(imm)][7:0])",
      "memory": "load",
